{
  "name": "Rate limit /jobs.json",
  "description": "30 requests per 60s per client IP on the public /jobs.json feed; excess gets HTTP 429.",
  "active": true,
  "conditionGroup": [
    { "conditions": [{ "type": "path", "op": "eq", "value": "/jobs.json" }] }
  ],
  "action": {
    "mitigate": {
      "action": "rate_limit",
      "rateLimit": {
        "algo": "fixed_window",
        "window": 60,
        "limit": 30,
        "keys": ["ip"],
        "action": "rate_limit"
      }
    }
  }
}
