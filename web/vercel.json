{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/:path*.txt",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/icon",
      "headers": [{ "key": "Content-Type", "value": "image/png" }]
    },
    {
      "source": "/apple-icon",
      "headers": [{ "key": "Content-Type", "value": "image/png" }]
    }
  ]
}
